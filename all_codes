#to write the correlation values into a csv
snp_cols <- grep("^chr", names(merged_data), value = TRUE)

merged_data <- merged_data[complete.cases(merged_data[, snp_cols]), ]

out <- data.frame()

for (snp in snp_cols) {
  for (g in 0:2) {

    idx <- merged_data[[snp]] == g
    if (sum(idx) < 3) next

    ct <- cor.test(
      merged_data$Gcase_activity[idx],
      merged_data$GALC_activity[idx]
    )

    out <- rbind(out, data.frame(
      SNP = snp,
      genotype = g,
      N = sum(idx),
      r = ct$estimate,
      p = ct$p.value,
      CI_low = ct$conf.int[1],
      CI_high = ct$conf.int[2]
    ))
  }
}

write.csv(out,"Gcase_Galc_combined_corr.csv",row.names=T)

write.table(out,"Gcase_Galc_combined_corr.csv",sep=",",row.names=F,col.names=T,quote=F)

