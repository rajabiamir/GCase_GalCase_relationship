#to perform Fisher's r-to-z test to determine whether two correlations are statistically significantly different
library(dplyr)
library(tidyr)
library(purrr)
library(cocor)

test_snp_genotype_cor_diff <- function(df,
                                      snp_col = "SNP",
                                      geno_col = "genotype",
                                      n_col   = "N",
                                      r_col   = "r",
                                      alternative = "two.sided") {

  d1 <- df %>%
  group_by(SNP, genotype) %>%
  summarise(
    N = first(N),
    r = first(r),
    .groups = "drop"
  )

  wide <- d1 %>%
    mutate(genotype = paste0("g", genotype)) %>%
    pivot_wider(names_from = genotype, values_from = c(N, r))

  run_one <- function(r1, r2, n1, n2) {
    ht <- cocor.indep.groups(
      r1.jk = r1, r2.hm = r2, n1 = n1, n2 = n2,
      alternative = alternative,
      test = "fisher1925",
      return.htest = TRUE
    )
    list(z = unname(ht$fisher1925$statistic), p = ht$fisher1925$p.value)
  }

  out <- bind_rows(
    wide %>%
      mutate(tmp = pmap(list(r_g0, r_g1, N_g0, N_g1), run_one)) %>%
      transmute(SNP,
                comparison = "0_vs_1",
                r1 = r_g0, n1 = N_g0,
                r2 = r_g1, n2 = N_g1,
                z = map_dbl(tmp, "z"),
                p_value = map_dbl(tmp, "p")),
    wide %>%
      mutate(tmp = pmap(list(r_g0, r_g2, N_g0, N_g2), run_one)) %>%
      transmute(SNP,
                comparison = "0_vs_2",
                r1 = r_g0, n1 = N_g0,
                r2 = r_g2, n2 = N_g2,
                z = map_dbl(tmp, "z"),
                p_value = map_dbl(tmp, "p")),
    
  ) %>%
    arrange(SNP, comparison)

  out
}

results_df <- test_snp_genotype_cor_diff(df)


